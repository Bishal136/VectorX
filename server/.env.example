PORT=5000
NODE_ENV=production
MONGODB_URI=your_mongodb_connection_string

# Live Frontend URL (NO trailing slash)
FRONTEND_URL=https://your-frontend-domain.com

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Authorized Redirect URIs in Google Cloud Console EXACTLY:
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback
SESSION_SECRET=your_session_secret

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Walletmix Payment Gateway
WALLETMIX_API_URL=https://api.walletmix.com/v1
WALLETMIX_API_KEY=your_api_key
WALLETMIX_SECRET_KEY=your_secret_key
WALLETMIX_MERCHANT_ID=your_merchant_id
WALLETMIX_REDIRECT_URL=https://your-frontend-domain.com/payment/success
WALLETMIX_CANCEL_URL=https://your-frontend-domain.com/payment/cancel
WALLETMIX_WEBHOOK_URL=https://your-backend-domain.com/api/payments/webhook
