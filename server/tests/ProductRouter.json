    {
      "name": "2. Protected Review Routes (User)",
      "item": [
        {
          "name": "2.1 Submit Product Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Review submitted successfully', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.review).to.have.property('rating');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data.review && jsonData.data.review.id) {",
                  "        pm.collectionVariables.set('reviewId', jsonData.data.review.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"title\": \"Excellent product!\",\n  \"comment\": \"This product exceeded my expectations. Great quality and fast delivery.\",\n  \"orderId\": \"{{orderId}}\",\n  \"images\": [\n    {\n      \"url\": \"https://example.com/review1.jpg\",\n      \"publicId\": \"reviews/img1\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}",
                "reviews"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.2 Submit Review (Low Rating)",
