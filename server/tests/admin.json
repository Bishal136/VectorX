          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Dashboard stats are returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('totalUsers');",
                  "    pm.expect(jsonData.data).to.have.property('totalSellers');",
                  "    pm.expect(jsonData.data).to.have.property('totalOrders');",
                  "    pm.expect(jsonData.data).to.have.property('totalRevenue');",
                  "    pm.expect(jsonData.data).to.have.property('totalProducts');",
                  "    pm.expect(jsonData.data).to.have.property('recentOrders');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
